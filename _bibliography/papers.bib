@inproceedings{silva2025viewpoint,
  abbr      = {AMD GTAC},
  title     = {A Quantitative Study of the Extent to Which Region-of-Interest Can Be Used for Viewpoint Motion Prediction},
  author    = {Silva, Joe and Oliver, Thomas and Smith, William},
  booktitle = {AMD Global Technical Authors Conference (internal)},
  year      = {2025},
  abstract  = {Cloud gaming adds a network round trip between a player's input and the frame they see. This work develops predictive models that use frame data to anticipate viewpoint motion in video games, so frames can be pre-rendered and delivered ahead of time. A multimodal seq2seq LSTM model taking past motion, semantic segmentation and depth outperforms a motion-only baseline, and could mask up to 171 ms of round-trip latency (a 51 ms improvement over prior work). The predictions are also used to build QP maps that guide the video encoder, improving VMAF across H.264, H.265 and AV1. Completed as a final-year project at the University of York in partnership with AMD.},
  pdf       = {https://github.com/jjzsilva9/viewpoint-prediction/blob/main/Final_Year_Project%20(5).pdf},
  code      = {https://github.com/jjzsilva9/viewpoint-prediction},
  preview   = {viewpoint.png},
  award     = {Second place in its category at the 2025 AMD Global Technical Authors Conference.},
  award_name = {2nd Place},
  bibtex_show = {true},
  selected  = {true}
}
